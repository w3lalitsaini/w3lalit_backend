# =================================================================
# W3 LALIT PORTFOLIO BACKEND — ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port (Render sets this automatically; defaults to 3000 locally)
PORT=3000

# Environment Mode ('development' | 'production')
NODE_ENV=production

# Frontend Client URL (Whitelisted for CORS)
FRONTEND_URL=https://w3lalit.vercel.app

# MongoDB Atlas Connection URI
# Renamed and scoped specifically for this project (database: w3lalit)
# Replace <db_password> with your actual MongoDB Atlas database user password
MONGO_URI=mongodb+srv://sainilalit082_db_user:<db_password>@cluster0.1iegicn.mongodb.net/w3lalit?compressors=zlib&retryWrites=true&w=majority

# JWT Secret for Administrative Authentication & Token Signing
JWT_SECRET=w3lalit_secure_jwt_secret_key_2026

# Cloudinary Media Assets Storage (Optional / Extensible)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
